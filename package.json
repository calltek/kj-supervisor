{
    "name": "kj-supervisor",
    "version": "0.1.0",
    "description": "Kujira supervisor — orchestrates Claude agent containers on a customer VPS",
    "private": true,
    "type": "module",
    "main": "src/main.ts",
    "scripts": {
        "prebuild": "bun run pull-protocol",
        "pull-protocol": "bun run scripts/pull-protocol.ts",
        "pull-protocol:dev": "bun run scripts/pull-protocol.ts development",
        "dev": "bun --watch src/main.ts",
        "start": "bun src/main.ts",
        "build": "bun build src/main.ts --target bun --outdir dist",
        "lint": "biome check --write src scripts",
        "check": "biome check src scripts",
        "format": "biome format --write src scripts",
        "test": "bun test"
    },
    "dependencies": {
        "dockerode": "^5.0.0",
        "html-to-text": "^9.0.5",
        "imapflow": "^1.0.196",
        "mailparser": "^3.7.4",
        "mysql2": "^3.24.6",
        "nodemailer": "^10.4.0",
        "pg": "^8.23.1",
        "pino": "^9.5.0",
        "socket.io-client": "^4.8.3",
        "ssh2": "^1.17.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.14",
        "@types/bun": "^1.3.13",
        "@types/dockerode": "^4.0.1",
        "@types/html-to-text": "^9.0.4",
        "@types/mailparser": "^3.9.0",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/ssh2": "^1.15.6",
        "pino-pretty": "^13.1.3",
        "typescript": "^5.9.3"
    }
}
