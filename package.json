{
    "name": "kj-agent",
    "version": "0.1.0",
    "description": "Kujira supervisor — orchestrates Claude agent containers on a customer VPS",
    "private": true,
    "type": "module",
    "main": "src/main.ts",
    "scripts": {
        "prebuild": "bun run pull-protocol",
        "pull-protocol": "bun run scripts/pull-protocol.ts",
        "pull-protocol:dev": "bun run scripts/pull-protocol.ts development",
        "dev": "bun --watch src/main.ts",
        "start": "bun src/main.ts",
        "build": "bun build src/main.ts --target bun --outdir dist",
        "lint": "biome check --write src scripts",
        "check": "biome check src scripts",
        "format": "biome format --write src scripts",
        "test": "bun test"
    },
    "dependencies": {
        "pino": "^9.5.0",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.14",
        "@types/bun": "^1.3.13",
        "pino-pretty": "^13.1.3",
        "typescript": "^5.9.3"
    }
}
