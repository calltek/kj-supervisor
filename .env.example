# Copy this to .env and fill in the values. .env is gitignored.

# URL base of the control plane (kj-backend). No trailing slash.
#   dev   → http://localhost:5050
#   prod  → https://api.kujira.run
KJ_CONTROL_URL=http://localhost:5050

# Provisioning token from the operator panel. Single-use, 24h TTL.
# Only needed on first boot; after the first successful handshake the
# supervisor stores a persistent agent_token at $KJ_CONFIG_DIR/token.
KJ_PROVISIONING_TOKEN=kjprov_...

# Dev override for the persistent agent_token. Normally read from disk;
# leave commented out unless you know why you need this.
# KJ_AGENT_TOKEN=kjagt_...

# Where to persist the agent_token. Defaults to /etc/kj-agent.
# For dev keep it inside the repo (gitignored under local/).
KJ_CONFIG_DIR=./local/etc-kj-agent

# Log verbosity: debug | info | warn | error. Defaults to info.
KJ_LOG_LEVEL=debug
