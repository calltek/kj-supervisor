# Copy this to .env.local and fill in the values. .env.local is gitignored.

# ─── Wire to the control ─────────────────────────────────────────────

# URL base of the control plane (kj-backend). No trailing slash.
#   dev   → http://localhost:5050
#   prod  → https://api.kujira.run
KJ_CONTROL_URL=http://localhost:5050


# ─── Optional ────────────────────────────────────────────────────────

# Where the agent_token is read from. Defaults to /etc/kj-supervisor in
# production; for dev keep it inside the repo (gitignored under local/).
# The token itself is written by install.sh after exchanging the
# operator's provisioning_token via POST /provisioning/bundle.
KJ_CONFIG_DIR=./local/etc-kj-supervisor

# Log verbosity: debug | info | warn | error. Defaults to info.
KJ_LOG_LEVEL=debug

# Container name of the supervisor itself, needed for the blue/green
# self-upgrade. Only relevant once running inside Docker.
# KJ_SUPERVISOR_CONTAINER=kj-supervisor


# ─── Dev quick reference ─────────────────────────────────────────────
# Pre-created resources on the local backend (see CLAUDE.md §11):
#   - User:         id=1, email=supervisor-dev@kujira.local
#   - Organization: id=1, name="Kujira Dev"
#   - Server:       id=1, name="dev-laptop"
#
# Bootstrap a dev supervisor:
#   1. Get a JWT (7d TTL):
#      curl -s -X POST http://localhost:5050/auth/login \
#        -H 'Content-Type: application/json' \
#        -d '{"email":"supervisor-dev@kujira.local","password":"<password>"}'
#
#   2. Mint a provisioning_token (24h TTL):
#      curl -s -X POST http://localhost:5050/org/1/server/1/regenerate-provisioning-token \
#        -H "Authorization: Bearer <JWT>"
#
#   3. Exchange it for an agent_token and persist to disk:
#      mkdir -p ./local/etc-kj-supervisor
#      curl -s -X POST http://localhost:5050/provisioning/bundle \
#        -H "Content-Type: application/json" \
#        -d '{"provisioning_token":"kjprov_..."}' \
#        | jq -r .agent_token > ./local/etc-kj-supervisor/token
#      chmod 600 ./local/etc-kj-supervisor/token
